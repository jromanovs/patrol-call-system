#!/bin/sh
# Checks every text file a record is about to carry.
#
# Without arguments it takes the files staged for the record; with arguments
# it takes those files, so CI runs the same checks over the whole tree.
# Files are read from disk: anything staged but since edited is judged as it
# now stands.
set -eu

if [ -n "${SKIP_CHECKS_BECAUSE:-}" ]; then
  printf 'Checks skipped: %s\n' "$SKIP_CHECKS_BECAUSE" >&2
  exit 0
fi

said=$(mktemp)
words=$(mktemp)
trap 'rm -f "$said" "$words"' EXIT

# The list names what must never be published, so it lives outside the
# repository and CI runs without it.
list="${XDG_CONFIG_HOME:-$HOME/.config}/git/forbidden-words"

if [ "$#" -eq 0 ]; then
  staged=$(git diff --cached --name-only --diff-filter=ACMR)
  while IFS= read -r file; do
    set -- "$@" "$file"
  done <<EOF
$staged
EOF
fi

# Encrypted files look like text but are data: a changed byte breaks them.
for file do
  shift
  case $file in
    *.enc) continue ;;
  esac
  if [ -f "$file" ] && grep -Iq '' "$file"; then
    set -- "$@" "$file"
  fi
done
[ "$#" -gt 0 ] || exit 0

gate() {
  name="$1"
  shift
  if "$@" >"$said" 2>&1; then
    printf '  %s\n' "$name"
    return 0
  fi
  printf '\n%s: failed\n\n' "$name" >&2
  cat "$said" >&2
  printf '\nChecks failed, nothing committed.\n' >&2
  printf 'To bypass with a reason: SKIP_CHECKS_BECAUSE="why" git commit ...\n' >&2
  exit 1
}

no_trailing_whitespace() {
  ! grep -nHE '[[:blank:]]+$' -- "$@"
}

newline_at_end() {
  missing=0
  for file do
    if [ -n "$(tail -c 1 "$file")" ]; then
      printf '%s: no newline at end of file\n' "$file"
      missing=1
    fi
  done
  return "$missing"
}

# Addresses under the reserved example domains and GitHub's noreply domain
# reach nobody's mailbox; domain names are compared in any letter case.
no_mail_addresses() {
  ! grep -noHE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' -- "$@" |
    grep -viE '@(example\.(com|org|net)|users\.noreply\.github\.com)$'
}

# A blank line in a pattern list matches every line, so only real entries go
# to grep.
no_forbidden_words() {
  grep -vE '^[[:space:]]*(#|$)' "$list" >"$words" || return 0
  ! grep -nHiwF -f "$words" -- "$@"
}

markdown_formatted() {
  if ! command -v prettier >/dev/null; then
    printf 'prettier is not installed\n'
    return 1
  fi
  prettier --check -- "$@"
}

# A wider table row breaks apart in an editor that wraps long lines.
tables_fit() {
  ! perl -CSD -ne 'chomp; printf "%s:%d: table row is %d characters, limit 80\n", $ARGV, $., length if /^\s*\|/ && length > 80; close ARGV if eof' -- "$@" |
    grep .
}

haml_style() {
  for file do
    shift
    case $file in
      *.haml) set -- "$@" "$file" ;;
    esac
  done
  [ "$#" -gt 0 ] || return 0
  bundle exec haml-lint "$@"
}

gate "Trailing whitespace" no_trailing_whitespace "$@"
gate "Newline at end of file" newline_at_end "$@"
gate "E-mail addresses" no_mail_addresses "$@"
if [ -f "$list" ]; then
  gate "Forbidden words" no_forbidden_words "$@"
else
  printf '  Forbidden words: skipped, no list at %s\n' "$list"
fi

# Ruby and HAML style need the application's own tools, so they run only
# where the application is installed.
if [ -x bin/rubocop ]; then
  gate "Ruby style (RuboCop)" bin/rubocop --only-recognized-file-types --force-exclusion "$@"
  gate "HAML style (haml-lint)" haml_style "$@"
fi

for file do
  shift
  case $file in
    *.md | *.markdown) set -- "$@" "$file" ;;
  esac
done
[ "$#" -gt 0 ] || exit 0

gate "Markdown formatting (prettier)" markdown_formatted "$@"
gate "Markdown table width" tables_fit "$@"
