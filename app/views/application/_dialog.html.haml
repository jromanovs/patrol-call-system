-# DYN-07: a dialog in the modal frame; the dialog controller opens it as a modal.
= turbo_frame_tag "modal" do
  %dialog.dialog{ data: { controller: "dialog" }, aria: { labelledby: "dialog-title" } }
    .dialog-heading
      %h2#dialog-title= title
      %button.dialog-close{ type: "button", aria: { label: "Close the dialog" }, data: { action: "dialog#close" } } ×
    = yield
