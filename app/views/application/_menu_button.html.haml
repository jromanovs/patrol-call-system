-# In a narrow window the sections open from this button; it comes before the
  system's name so that the keyboard reaches it first, as the eye does.
%button.header-button.menu-button{ type: "button", popovertarget: "main-menu" }
  %svg.icon{ viewBox: "0 0 24 24", width: 24, height: 24, aria: { hidden: "true" } }
    %path{ d: "M4 7h16M4 12h16M4 17h16" }
  %span.visually-hidden Menu
