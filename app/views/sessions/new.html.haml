- content_for(:title, "#{t('.title')} — Patrol Call System")
.sign-in.form-card
  %h1= t(".title")

  = form_with url: session_path do |form|
    .field
      = form.label :email_address, t(".email_address")
      %span.hint#email-address-hint= t(".email_address_hint")
      = form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
        value: params[:email_address], aria: { describedby: "email-address-hint" }
    .field
      = form.label :password, t(".password")
      %span.hint#password-hint= t(".password_hint")
      = form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
        aria: { describedby: "password-hint" }
    -# USR-10: the check shows the words it is handed, by the names its library has for them.
    %altcha-widget{ challenge: captcha_challenge_path, name: "altcha", strings: captcha_words.to_json }
    = form.submit t(".submit"), class: "button"

  - if Rails.configuration.x.google_sign_in
    %p.divider= t(".alternative")
    = button_to t(".google"), "/auth/google_oauth2", method: :post, data: { turbo: false },
      class: "button button-secondary"

  %p.note= t(".no_account")
