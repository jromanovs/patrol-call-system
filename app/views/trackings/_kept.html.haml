-#
  TRK-05, BR-20: for how many months car positions are kept, as the page
  Settings holds it. The map's own 30 days are named, so that nobody takes
  them for the period.
%section.tracking-setup{ aria: { labelledby: "tracking-kept-title" } }
  %h2#tracking-kept-title= t("common.kept.positions_title")
  %p= t(".kept_html", months: tag.strong(t("common.kept.months", count: setting.position_months)))
  %p.note.kept-now
    - if oldest
      = t("common.kept.positions_since_html", day: tag.strong(l(oldest)))
    - else
      = t("common.kept.no_positions")
  %p.note= t("common.kept.map_shows", days: CarPosition::SHOWN.in_days.to_i)
  %p.note= link_to t("common.kept.change"), settings_path
