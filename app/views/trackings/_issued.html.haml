-#
  TRK-02: the identifier just issued, shown this once, with what to do with
  it; Done, leaving or a reload shows the page without it. The clipboard
  controller takes from here what it says after a copy.
%section.tracking-key{ aria: { labelledby: "tracking-key-title" },
  data: { controller: "clipboard", clipboard_copied_text_value: t(".copied"),
          clipboard_failed_text_value: t(".not_copied") } }
  %h2#tracking-key-title= t(".title", car: issued["car"])
  .tracking-key-value
    %code.secret{ data: { clipboard_target: "source" } }= issued["key"]
    %button.button{ type: "button", data: { action: "clipboard#copy", clipboard_target: "button" } }= t(".copy")
  -# What the copying came to, read out and shown.
  %p.tracking-key-status{ role: "status", data: { clipboard_target: "status" } }
  %ol
    %li= t(".press_copy_html", copy: tag.strong(t(".copy_at_end")))
    %li= t(".paste_html", field: tag.strong(t(".field_in_list")), url: tag.code(traccar_url))
    %li= t(".switch_on_html", done: tag.strong(t(".done")))
  .tracking-key-end
    = link_to t(".done"), tracking_path, class: "button button-secondary"
    %span= t(".after_done")
