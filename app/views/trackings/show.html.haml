- content_for(:title, "#{t('.title')} — Patrol Call System")
-# Turbo keeps no copy of this page, so Back never shows an identifier again.
- content_for(:head, tag.meta(name: "turbo-cache-control", content: "no-cache"))
.page-heading
  %h1= t(".title")
= render "trackings/issued", issued: @issued if @issued
%section.tracking-setup{ aria: { labelledby: "tracking-sources-title" } }
  %h2#tracking-sources-title= t(".sources_title")
  %p.note#source-hint= t(".saved_at_once")
  %table.data-table.tracking
    %thead
      %tr
        %th{ scope: "col" }= t("trackings.columns.car")
        %th{ scope: "col" }= t("trackings.columns.source")
        %th{ scope: "col" }= t("trackings.columns.identifier")
        %th{ scope: "col" }= t("trackings.columns.last_position")
        %th{ scope: "col" }
          %span.visually-hidden= t("common.actions")
    %tbody
      - @cars.each do |car|
        = render "trackings/car", car:, position: @positions[car.id]
= render "trackings/kept", setting: @setting, oldest: @oldest
%section.tracking-setup{ aria: { labelledby: "tracking-meaning-title" } }
  %h2#tracking-meaning-title= t(".meaning_title")
  %p= t(".not_tracked_html", source: tag.strong(t("trackings.sources.not_tracked")))
  %p= t(".traccar_html", source: tag.strong(t("trackings.sources.traccar")), url: traccar_url)
  %p= t(".crew_phone_html", source: tag.strong(t("trackings.sources.crew_phone")))
