= form_with model: user, class: "form" do |form|
  = render "error_summary", form: form, record: user
  .form-card.form
    .field
      = form.label :name
      %span.hint{ id: form.field_id(:name, :hint) } 2 to 100 characters, e.g. Demo Dispatcher
      = field_error(user, :name)
      = form.text_field :name, required: true, maxlength: 100, aria: { describedby: field_description(user, :name) }
    .field
      = form.label :email_address, "E-mail address"
      %span.hint{ id: form.field_id(:email_address, :hint) } Example: dispatcher@example.com
      = field_error(user, :email_address)
      = form.email_field :email_address, required: true,
        aria: { describedby: field_description(user, :email_address) }
    .field
      = form.label :role
      %span.hint{ id: form.field_id(:role, :hint) }
        Dispatcher: calls, sites and cars. Supervisor: also deletes calls. Administrator: also users.
        Crew: the call of its car only
      = field_error(user, :role)
      = form.select :role, User.roles.keys.map { |role| [ role.humanize, role ] }, {},
        aria: { describedby: field_description(user, :role) }
    .field
      = form.label :patrol_car_id, "Car"
      %span.hint{ id: form.field_id(:patrol_car_id, :hint) } For a crew only: the car whose calls it works
      = field_error(user, :patrol_car_id)
      = form.collection_select :patrol_car_id, PatrolCar.order(:call_sign), :id, :call_sign, { include_blank: "None" },
        aria: { describedby: field_description(user, :patrol_car_id) }
    .field
      = form.label :password
      %span.hint{ id: form.field_id(:password, :hint) }
        = user.persisted? ? "Leave empty to keep the current password" : "12 to 72 characters"
      = field_error(user, :password)
      = form.password_field :password, autocomplete: "new-password", maxlength: 72,
        aria: { describedby: field_description(user, :password) }
    - if user.persisted?
      .field.field-checkbox
        = form.check_box :active, aria: { describedby: field_description(user, :active) }
        %span.field-text
          = form.label :active
          %span.hint{ id: form.field_id(:active, :hint) } An inactive user cannot sign in
    %div
      = form.submit class: "button"
