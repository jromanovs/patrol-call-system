- content_for(:title, "Users — Patrol Call System")
.page-heading
  %h1 Users
  = link_to "New user", new_user_path, class: "button"

%table.data-table
  %thead
    %tr
      %th Name
      %th E-mail address
      %th Role
      %th Active
      %th Last sign-in
      %th
        %span.visually-hidden Actions
  %tbody
    - @users.each do |user|
      %tr
        %td.user-cell{ data: { label: "Name" } }
          = avatar(user, aria: { hidden: "true" })
          = link_to user.name, edit_user_path(user)
        %td{ data: { label: "E-mail address" } }= user.email_address
        %td{ data: { label: "Role" } }= [ user.role.humanize, user.patrol_car&.call_sign ].compact.join(" · ")
        %td{ data: { label: "Active" } }= user.active? ? "yes" : "no"
        %td.numeric{ data: { label: "Last sign-in" } }
          = user.last_signed_in_at ? l(user.last_signed_in_at) : "—"
        %td{ data: { label: "Actions" } }
          = button_to "Delete", user_path(user), method: :delete, class: "button button-secondary button-small",
            form: { data: { turbo_confirm: "Delete #{user.name}?" } }
