- content_for(:title, "#{t('.title')} — Patrol Call System")
%h1= t(".heading", name: @user.name)
.user-edit
  = render "form", user: @user
  -# USR-08: apart from the form, so that saving the form changes no password.
  %section.setting-card{ aria: { labelledby: "user-password-title" } }
    %h2#user-password-title= t(".password")
    - if @user == Current.user
      %p= t(".own_html", link: link_to(t(".own_link"), profile_path))
    - else
      %p= t(@user.crew? ? ".set_for_crew" : ".set_for_user")
      = link_to t(".set_password"), edit_user_password_path(@user), class: "button button-secondary",
        data: { turbo_frame: "modal" }
