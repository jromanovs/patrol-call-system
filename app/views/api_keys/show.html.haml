- content_for(:title, "#{t('.title')} — Patrol Call System")
-# Turbo keeps no copy of this page, so Back never shows a key again.
- content_for(:head, tag.meta(name: "turbo-cache-control", content: "no-cache"))
- user = Current.user
%h1= t(".title")
%p.note= t(".use")
- if @key
  %p.flash.flash-notice{ role: "status" }= t(".copy_now")
  %code.secret#api-key= @key
- elsif user.api_key_issued_at
  %p= t(".issued", time: l(user.api_key_issued_at))
- else
  %p= t(".no_key")
-# A full page load, not Turbo, so the page with the new key is shown at once.
= button_to t(".issue"), api_key_path, class: "button", form: { data: { turbo: false } }
%p.note= t(".stops")
