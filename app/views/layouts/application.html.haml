!!!
%html{ lang: I18n.locale, data: board_choices }
  %head
    %title= content_for(:title) || "Patrol Call System"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: "Patrol Call System" }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: "manifest", href: pwa_manifest_path(format: :json) }
    -#
      The icon by an address that changes with its picture: a browser keeps
      what it got at a fixed address for a year.
    %link{ rel: "icon", href: image_path("icon.png"), type: "image/png" }
    %link{ rel: "icon", href: image_path("icon.svg"), type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: image_path("icon.png") }
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
  -#
    USR-09: the theme stands on the body, which every visit brings anew; the
    html element stays through visits within the application.
  - marks = content_for?(:body_class) ? { class: content_for(:body_class) } : {}
  %body{ marks.merge(data: { theme: page_theme }) }
    %header.site-header
      .header-bar
        = render "menu_button" if menu_items.any?
        = link_to root_path, class: "brand", aria: { current: ("page" if home_page?) } do
          %svg.icon{ viewBox: "0 0 24 24", width: 22, height: 22, aria: { hidden: "true" } }
            %path{ d: "M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" }
            %path{ d: "M9 12l2 2 4-4" }
          Patrol Call System
        = render "menu" if menu_items.any?
        = render "theme", user: Current.user if Current.user
        = render "language" if Current.user && Language.offered.many?
        = render "account", user: Current.user if Current.user
    -# DSP-06, DYN-19: a crew's SOS reaches the staff on whatever page they are.
    - staff = Current.user && !Current.user.crew?
    = render "sos_calls/strips", calls: SosCall.unacknowledged.to_a if staff
    = render "flash"
    %main
      = yield
    -# DYN-07: dialogs (dispatch, close, cancel) load into this frame.
    = turbo_frame_tag "modal"
    -# USR-10: the strips come worded, so a page listens for those of its language.
    = turbo_stream_from :sos, I18n.locale if staff
