= turbo_frame_tag "address-suggestions" do
  - if @text.strip.length < 3
    %p.hint Enter at least 3 characters
  - elsif @addresses.empty?
    %p.hint No address found
  - else
    %ul.suggestions
      - @addresses.each do |address|
        %li
          %button.suggestion{ type: "button",
            data: { action: "address-picker#choose", address_id: address.id, address_label: address.full_address } }
            = address.full_address
  %p.source Source: State Address Register (VZD), data.gov.lv
