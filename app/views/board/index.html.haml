- content_for :head do
  = turbo_refreshes_with method: :morph, scroll: :preserve
= turbo_stream_from :board

.board
  %section{ aria: { labelledby: "calls-title" } }
    .page-heading
      %h1#calls-title Active calls
      = link_to "Register call", new_call_path, class: "button"
    - if @calls.any?
      %table.data-table{ data: { controller: "waiting" } }
        %thead
          %tr
            %th Priority
            %th Site
            %th Call
            %th Status
            %th Car
            %th Waiting
            %th
              %span.visually-hidden Actions
        %tbody
          = render partial: "board/call", collection: @calls, as: :call
    - else
      %p No active calls.
  %aside.board-cars{ aria: { labelledby: "cars-title" } }
    .panel-heading
      %h2#cars-title Patrol cars
      - if @cars.any?
        %span.count #{@cars.count(&:available?)} available of #{@cars.size}
    - if @cars.any?
      %ul.cars
        - @cars.each do |car|
          %li
            %span.car
              = link_to car, class: "car-link" do
                %span.call-sign= car.call_sign
                %span.secondary= car.model
              %span.secondary= car.district.humanize
            %span{ class: "status-label status-#{car.status.dasherize}" }= car.status.humanize
    - else
      %p No cars yet.
