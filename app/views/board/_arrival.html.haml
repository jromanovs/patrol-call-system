-#
  DSP-03, DSP-05, CRW-06: where the car is, in words; the sign comes from the
  stylesheet. On the board and the crew screen the minutes since the dispatch,
  or since the acceptance, are recounted every minute; elsewhere the time of
  the step stays true.
- car = call.patrol_car&.call_sign
- live = local_assigns.fetch(:live, false)
%span.arrival{ data: { arrival: call.arrival } }
  %span
    - case call.arrival
    - when "waiting"
      = t(".waiting")
    - when "sent"
      - if live
        = t(".sent_live_html", car:, time: l(call.dispatched_at, format: "%H:%M"),
          minutes: counted_minutes(call.dispatch_minutes, call.dispatched_at))
      - else
        = t(".sent", car:, time: l(call.dispatched_at, format: "%H:%M"))
    - when "unanswered"
      - if live
        = t(".unanswered_live_html", car:, minutes: counted_minutes(call.dispatch_minutes, call.dispatched_at))
      - else
        = t(".unanswered", car:, time: l(call.dispatched_at, format: "%H:%M"))
    - when "on-the-way"
      - if live
        = t(".on_the_way_live_html", car:, time: l(call.accepted_at, format: "%H:%M"),
          minutes: counted_minutes(call.acceptance_minutes, call.accepted_at))
      - else
        = t(".on_the_way", car:, time: l(call.accepted_at, format: "%H:%M"))
    - when "on-site", "no-position"
      = t(".on_site", car:, time: l(call.arrived_at, format: "%H:%M"),
        place: arrival_place(call.arrival_position))
    - when "far"
      = far_arrival_text(car, call.arrival_position)
