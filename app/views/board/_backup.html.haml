-#
  DSP-03, BR-22: where a further car of a call is, in the words used for the
  call's own car, and the steps it has left — what its crew told by radio
  (UPD-15), and its release (UPD-16).
- car = backup.patrol_car.call_sign
- small = "button button-secondary button-small"
%span.arrival.backup{ data: { arrival: backup.state } }
  %span
    - case backup.state
    - when "sent"
      = t(".sent", car:, time: l(backup.sent_at, format: "%H:%M"))
    - when "on-the-way"
      = t(".on_the_way", car:, time: l(backup.accepted_at, format: "%H:%M"))
    - when "far"
      = far_arrival_text(car, backup.arrival_position)
    - else
      = t(".on_site", car:, time: l(backup.arrived_at, format: "%H:%M"),
        place: arrival_place(backup.arrival_position))
%span.secondary= t(".further_car")
.row-actions{ data: { label: t("common.actions") } }
  - unless backup.accepted_at
    = button_to t("calls.steps.accepted"), accept_call_backup_path(call, backup), class: small,
      form: { data: { turbo_frame: "_top" } }
  - unless backup.arrived_at
    = button_to t("calls.steps.arrived"), arrive_call_backup_path(call, backup), class: "button button-small",
      form: { data: { turbo_frame: "_top" } }
  = button_to t("calls.steps.release"), release_call_backup_path(call, backup), class: small,
    form: { data: { turbo_frame: "_top" } }
