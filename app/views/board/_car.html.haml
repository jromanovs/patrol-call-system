-#
  DSP-03: a car of the cars panel — its status, how old its position is
  (TRK-03), and whether its crew asks for help (BR-21).
- sos = asking[car.id]
%li{ class: ("sos" if sos) }
  %span.car
    %span.car-name
      = link_to car, class: "car-link" do
        %span.call-sign= car.call_sign
        %span.secondary= car.model
      - if sos
        %span.sos-label= t("common.sos")
    %span.secondary= enum_name(PatrolCar, :district, car.district)
    - if (position = positions[car.id])
      %span.secondary
        - age = [ minutes_between(Time.current, position.recorded_at), 0 ].max
        = t(".position_html", minutes: counted_minutes(age, position.recorded_at))
    - if sos
      %span.sos-waits
        = t(sos.acknowledged_at ? ".signal_acknowledged" : ".signal_waits", time: l(sos.received_at, format: "%H:%M"))
  %span{ class: "status-label status-#{car.status.dasherize}" }= enum_name(PatrolCar, :status, car.status)
