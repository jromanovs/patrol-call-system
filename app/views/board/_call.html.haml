-#
  DSP-03: a call as a card of the board; the site name shows it on the map,
  once there is one. A crew's SOS has no site: it is named by its car, shown
  by the place of its signal, and says whether it is acknowledged (BR-21).
- site = call.guarded_site
- sos = call.is_a?(SosCall)
%article.call-card{ id: dom_id(call),
  class: [ ("critical" if call.critical?), ("fresh" if call.critical? && call.fresh?), ("sos" if sos) ],
  data: { site: dom_id(site || call, :map), board_target: "card" } }
  .call-card-head
    - if sos
      %span.sos-label= t("common.sos")
    - priority = enum_name(Call, :priority, call.priority)
    %span{ class: "priority-label priority-#{call.priority}", data: { label: t(".priority") } }= priority
    - status = enum_name(Call, :status, call.status)
    %span{ class: "status-label status-#{call.status.dasherize}", data: { label: t(".status") } }= status
    %span.waiting{ data: { label: t(".waiting") } }
      %span.primary{ data: { waiting_target: "minutes", received_at: call.received_at.iso8601 } }
        = t("common.minutes", count: call.waiting_minutes)
      %span.secondary= l(call.received_at)
  %div{ data: { label: sos ? t(".crew") : t(".site") } }
    -# A crew's SOS without a place has no mark to show.
    - if map && call.destination
      %button.call-card-site{ type: "button",
        data: { action: "board#show", board_site_param: dom_id(site || call, :map) } }
        = call.place
    - else
      %span.primary= call.place
    %span.secondary= site ? "#{site.contract_number} · #{site.address.full_address}" : call.place_detail
  %div{ data: { label: t(".call") } }
    %span.primary= call.summary
    %span.secondary= call.detail
  -# Each car has its line of state and, beside it, the steps it has left (UPD-08, UPD-12).
  .car-state{ data: { label: t(".arrival") } }
    = render "board/arrival", call:, live: true
    - if call.dispatched? || call.accepted?
      .row-actions{ data: { label: t("common.actions") } }
        - if call.dispatched?
          = button_to t("calls.steps.accepted"), call_acceptance_path(call),
            class: "button button-secondary button-small", form: { data: { turbo_frame: "_top" } }
        = button_to t("calls.steps.arrived"), call_arrival_path(call), class: "button button-small",
          form: { data: { turbo_frame: "_top" } }
  -# BR-22: every further car has its own line and its own steps.
  - call.backups.reject(&:released_at).each do |backup|
    .car-state{ data: { label: t(".further_car") } }= render "board/backup", call:, backup:
  - if sos
    %div{ data: { label: t(".signal") } }
      - if call.acknowledged_at
        %span.secondary
          = t(".acknowledged", time: l(call.acknowledged_at, format: "%H:%M"), name: call.acknowledged_by.name)
      - else
        %span.sos-waits= t(".not_acknowledged")
  .row-actions{ data: { label: t("common.actions") } }
    = render "board/steps", call: call
    = link_to t("common.edit"), edit_call_path(call), class: "button button-secondary button-small"
