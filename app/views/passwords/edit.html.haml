- content_for(:title, "#{t('.title')} — Patrol Call System")
.page-heading
  %h1= t(".title")
= form_with model: @user, scope: :user, url: password_path, method: :patch, class: "form" do |form|
  = render "error_summary", form: form, record: @user
  .form-card.form
    -# BR-13: the key goes with the password it was issued under.
    - if @user.api_key_issued_at
      %p.caution= t(".key_void")
    = render "passwords/field", form:, user: @user, field: :password_challenge, kind: "current-password"
    = render "passwords/field", form:, user: @user, field: :password, kind: "new-password"
    = render "passwords/field", form:, user: @user, field: :password_confirmation, kind: "new-password"
    .form-answers
      = form.submit t(".submit"), class: "button"
      = link_to t("common.cancel"), profile_path, class: "button button-secondary"
