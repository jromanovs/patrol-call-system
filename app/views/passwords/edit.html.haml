- content_for(:title, "Change password — Patrol Call System")
.page-heading
  %h1 Change password
= form_with model: @user, scope: :user, url: password_path, method: :patch, class: "form" do |form|
  = render "error_summary", form: form, record: @user
  .form-card.form
    = render "passwords/field", form:, user: @user, field: :password_challenge, label: "Current password",
      hint: "The password you signed in with", kind: "current-password"
    = render "passwords/field", form:, user: @user, field: :password, label: "New password",
      hint: "12 to 72 characters; a letter outside the Latin alphabet counts as two or more", kind: "new-password"
    = render "passwords/field", form:, user: @user, field: :password_confirmation, label: "Repeat the new password",
      hint: "The same once more", kind: "new-password"
    .form-answers
      = form.submit "Change password", class: "button"
      = link_to "Cancel", profile_path, class: "button button-secondary"
