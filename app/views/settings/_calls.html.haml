-#
  DEL-09, BR-23: for how many months calls are kept, and from which day on a
  call cannot be deleted. The sentence tells what is in force, not what a
  refused field holds.
- refusal = setting.errors[:call_months].first
%section.setting-card{ aria: { labelledby: "calls-kept-title" } }
  %h2#calls-kept-title= t("common.kept.calls_title")
  = form_with url: settings_calls_path, method: :patch, class: "form" do |form|
    .field
      = form.label :call_months, t(".keep_for")
      - if refusal
        %span.field-error#call-months-error= refusal
      .field-unit
        = form.number_field :call_months, value: setting.call_months_before_type_cast, min: Setting::MONTHS.min,
          required: true, class: "short",
          aria: { describedby: [ "call-months-hint", ("call-months-error" if refusal) ].compact.join(" "),
                  invalid: ("true" if refusal) }
        %span= t(".months")
      %span.hint#call-months-hint= t(".hint", count: Setting::MONTHS.min)
    %div
      = form.submit t("common.save"), class: "button"
  %p.note.kept-now
    = t("common.kept.calls_html", months: tag.strong(t("common.kept.months", count: in_force.call_months)),
      day: tag.strong(l(in_force.calls_kept_from)))
