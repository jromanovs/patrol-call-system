= form_with model: car, class: "form",
  data: { controller: "check", action: "focusout->check#leave input->check#mend" } do |form|
  = render "error_summary", form: form, record: car
  .form-card.form
    .field
      = form.label :call_sign
      %span.hint{ id: form.field_id(:call_sign, :hint) }= t(".hints.call_sign")
      = field_error(car, :call_sign)
      = form.text_field :call_sign, class: "code", data: field_check(PatrolCar, :call_sign),
        aria: { describedby: field_description(car, :call_sign) }
    .field
      = form.label :plate_number
      %span.hint{ id: form.field_id(:plate_number, :hint) }= t(".hints.plate_number")
      = field_error(car, :plate_number)
      = form.text_field :plate_number, class: "code", data: field_check(PatrolCar, :plate_number),
        aria: { describedby: field_description(car, :plate_number) }
    .field
      = form.label :model
      %span.hint{ id: form.field_id(:model, :hint) }= t(".hints.model")
      = field_error(car, :model)
      = form.text_field :model, aria: { describedby: field_description(car, :model) }
    .field
      = form.label :crew_size, t(".crew")
      %span.hint{ id: form.field_id(:crew_size, :hint) }= t(".hints.crew_size")
      = field_error(car, :crew_size)
      = form.number_field :crew_size, class: "short", data: field_check(PatrolCar, :crew_size),
        aria: { describedby: field_description(car, :crew_size) }
    .field
      = form.label :district
      %span.hint{ id: form.field_id(:district, :hint) }= t(".hints.district")
      = field_error(car, :district)
      = form.select :district, enum_options(PatrolCar, :district), {},
        aria: { describedby: field_description(car, :district) }
    .field
      - if car.status.in?(PatrolCar::SET_BY_HAND)
        = form.label :status
        %span.hint{ id: form.field_id(:status, :hint) }= t(".hints.status")
        = field_error(car, :status)
        = form.select :status, enum_options(PatrolCar, :status, PatrolCar::SET_BY_HAND), {},
          aria: { describedby: field_description(car, :status) }
      - else
        %span.label-text= t(".status")
        %span.hint= t(".status_follows")
        %p= enum_name(PatrolCar, :status, car.status)
    %div
      = form.submit t(car.persisted? ? ".save" : ".create"), class: "button"
