- content_for(:title, "#{t('.title')} — Patrol Call System")
.page-heading
  %h1= t(".title")
  = link_to t(".new"), new_patrol_car_path, class: "button"

-# FLT-06: the form stays, only the list below it is reloaded.
= form_with url: patrol_cars_path, method: :get, class: "filters",
  data: { turbo_frame: "cars-list", controller: "auto-submit" } do |form|
  = hidden_field_tag :sort, params[:sort]
  = hidden_field_tag :direction, params[:direction]
  .field
    = form.label :q, t("common.search")
    %span.hint#q-hint= t(".search_hint")
    = form.search_field :q, value: @text, autocomplete: "off", aria: { describedby: "q-hint" },
      data: { action: "input->auto-submit#submit" }
  - PatrolCar::NAMED.each do |attribute|
    .field
      = form.label attribute, PatrolCar.human_attribute_name(attribute)
      %span.hint{ id: "#{attribute}-hint" }= t("common.any_or_one")
      = form.select attribute, enum_options(PatrolCar, attribute),
        { include_blank: t("common.all"), selected: params[attribute] },
        aria: { describedby: "#{attribute}-hint" }, data: { action: "change->auto-submit#submit" }

= turbo_frame_tag "cars-list", data: { turbo_action: "advance" } do
  - if @text.present? && @text.strip.length < 2
    %p.field-error= t("common.too_short")
  .list-summary
    %p.count= t(".count", count: @cars.size)
    - if params.values_at(:q, *PatrolCar::NAMED).any?(&:present?)
      = link_to t("common.clear"), patrol_cars_path, class: "clear", data: { turbo_frame: "_top" }
  - if @cars.any?
    %table.data-table
      %thead
        %tr
          %th= sort_link t(".call_sign"), "call_sign"
          %th= sort_link t(".plate_number"), "plate_number"
          %th= sort_link t(".model"), "model"
          %th= sort_link t(".crew"), "crew_size"
          %th= sort_link t(".district"), "district"
          %th= sort_link t(".status"), "status"
      %tbody
        - @cars.each do |car|
          %tr
            %td{ data: { label: t(".call_sign") } }= link_to car.call_sign, car, data: { turbo_frame: "_top" }
            %td{ data: { label: t(".plate_number") } }= car.plate_number
            %td{ data: { label: t(".model") } }= car.model
            %td.numeric{ data: { label: t(".crew") } }= car.crew_size
            %td{ data: { label: t(".district") } }= enum_name(PatrolCar, :district, car.district)
            %td{ data: { label: t(".status") } }
              %span{ class: "status-label status-#{car.status.dasherize}" }= enum_name(PatrolCar, :status, car.status)
