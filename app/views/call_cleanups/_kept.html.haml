-#
  DEL-09, BR-23: for how many months calls are kept, and from which day on a
  call cannot be deleted. The administrator sets the period on the page
  Settings; a supervisor reads it.
%section.setting-card{ aria: { labelledby: "calls-kept-title" } }
  %h2#calls-kept-title= t("common.kept.calls_title")
  %p
    = t("common.kept.calls_html", months: tag.strong(t("common.kept.months", count: setting.call_months)),
      day: tag.strong(l(setting.calls_kept_from)))
  - if policy(:setting).update?
    %p.note= link_to t("common.kept.change"), settings_path
  - else
    %p.note= t(".set_by_administrator")
