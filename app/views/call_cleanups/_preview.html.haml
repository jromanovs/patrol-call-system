-# DEL-07 step 1: the number of matching calls and the deletion of exactly them.
- if cleanup.errors.any?
  - cleanup.errors.full_messages.each do |message|
    %p.field-error= message
- elsif cleanup.before
  - count = cleanup.calls.count
  .list-summary
    %p.count= CallCleanup.matching(count)
  - if count.positive?
    - calls = pluralize(count, "call")
    = form_with url: call_cleanup_path, class: "cleanup-confirm",
      data: { turbo_frame: "_top", turbo_confirm: "Delete #{calls}? This cannot be undone." } do |form|
      = hidden_field_tag :before, cleanup.before
      - cleanup.statuses.each do |status|
        = hidden_field_tag "statuses[]", status, id: nil
      = hidden_field_tag :kind, cleanup.kind
      = hidden_field_tag :outcome, cleanup.outcome
      = hidden_field_tag :count, count
      = form.button "Delete #{calls}", class: "button"
- else
  %p.hint Choose the day to see how many calls match.
