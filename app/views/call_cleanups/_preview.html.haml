-# DEL-07 step 1: the number of matching calls and the deletion of exactly them.
- if cleanup.errors.any?
  - cleanup.errors.full_messages.each do |message|
    %p.field-error= message
- elsif cleanup.before
  - ids = cleanup.ids
  .list-summary
    %p.count= CallCleanup.matching(ids.size)
  - if ids.any?
    = form_with url: call_cleanup_path, class: "cleanup-confirm",
      data: { turbo_frame: "_top", turbo_confirm: t(".confirm", count: ids.size) } do |form|
      = hidden_field_tag :before, cleanup.before, id: nil
      - cleanup.statuses.each do |status|
        = hidden_field_tag "statuses[]", status, id: nil
      = hidden_field_tag :kind, cleanup.kind, id: nil
      = hidden_field_tag :outcome, cleanup.outcome, id: nil
      = hidden_field_tag :match, CallCleanup.fingerprint(ids), id: nil
      = form.button t(".delete", count: ids.size), class: "button"
- else
  %p.hint= t(".choose_day")
