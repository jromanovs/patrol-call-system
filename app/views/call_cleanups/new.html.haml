- content_for(:title, "#{t('.title')} — Patrol Call System")
.page-heading
  %h1= t(".title")

%p.note= t(".note")

= render "kept", setting: @setting

-# DYN-08: the form stays, only the number of matching calls is recounted.
= form_with url: new_call_cleanup_path, method: :get, class: "filters",
  data: { turbo_frame: "cleanup-preview", controller: "auto-submit" } do |form|
  .field
    = form.label :before, t(".before")
    %span.hint#before-hint= t(".before_hint", day: l(@setting.calls_kept_from))
    -# No max: a later day is sent and refused in the preview, in the page's own words (DEL-08).
    = form.date_field :before, value: @cleanup.before, aria: { describedby: "before-hint" },
      data: { action: "change->auto-submit#submit" }
  %fieldset.field
    %legend= t(".statuses")
    %span.hint#statuses-hint= t(".statuses_hint")
    .choices
      - CallCleanup::FINISHED.each do |status|
        %span.choice
          = check_box_tag "statuses[]", status, @cleanup.statuses.include?(status), id: "statuses-#{status}",
            aria: { describedby: "statuses-hint" }, data: { action: "change->auto-submit#submit" }
          = label_tag "statuses-#{status}", enum_name(Call, :status, status)
  .field
    = form.label :kind, t(".kind")
    %span.hint#kind-hint= t("common.any_or_one")
    = form.select :kind, call_kinds, { include_blank: t("common.all"), selected: @cleanup.kind },
      aria: { describedby: "kind-hint" }, data: { action: "change->auto-submit#submit" }
  .field
    = form.label :outcome, t(".outcome")
    %span.hint#outcome-hint= t(".outcome_hint")
    = form.select :outcome, enum_options(Call, :outcome),
      { include_blank: t("common.all"), selected: @cleanup.outcome },
      aria: { describedby: "outcome-hint" }, data: { action: "change->auto-submit#submit" }

= turbo_frame_tag "cleanup-preview", data: { turbo_action: "advance" } do
  = render "preview", cleanup: @cleanup
