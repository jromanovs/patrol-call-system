-#
  ADD-12: the question before an SOS goes, against a press by mistake; left
  alone it closes by itself (DYN-20). The signal carries where the phone is,
  waited for 3 seconds at most, as an SOS cannot wait for a position. Inside
  the dialog a short key would be looked up among the words of the dialog
  itself, so the keys are written in full.
= render layout: "dialog", locals: { title: t(".title"), timeout: 15 } do
  %p.note= t("crew_sos.new.note", car: @car.call_sign)
  = form_with url: crew_sos_path, class: "form",
    data: { turbo_frame: "_top", controller: "position", position_wait_value: 3000, position_age_value: 60_000,
            action: "submit->position#locate turbo:submit-end->position#reset" } do |form|
    = render "calls/position_fields"
    = form.button t("crew_sos.new.submit"), class: "button button-sos button-wide"
    -# Shown by the dialog controller when the server gives no answer.
    %p.field-error{ hidden: true, role: "alert", data: { dialog_target: "failed" } }= t("crew_sos.new.failed")
  - not_now = t("crew_sos.new.not_now")
  %button.button.button-secondary.button-wide{ type: "button", data: { action: "dialog#close" } }= not_now
  %p.secondary= t("crew_sos.new.nothing_sent")
