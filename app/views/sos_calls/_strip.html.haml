-#
  DSP-06: one signal — who asks, since when, how well the place is known,
  and the call its car has; then the place on the map, Acknowledge (UPD-13)
  and, until a car is sent, the sending of one (UPD-06).
- car = call.raised_by
- own = car.active_call
%section.sos-strip{ aria: { labelledby: dom_id(call, :strip) }, data: { controller: "waiting", sos_target: "strip" } }
  %span.sos-sign{ aria: { hidden: "true" } } !
  .sos-words
    -# The heading is read out when the strip comes; the minutes, counted on, are not.
    %div
      %h2{ id: dom_id(call, :strip), role: "alert" }
        = t(".title", car: car.call_sign, time: l(call.received_at, format: "%H:%M"))
      %span= t(".ago_html", minutes: counted_minutes(call.waiting_minutes, call.received_at))
    %p
      = call.place_detail
      - if call.signals > 1
        · #{t(".signals", count: call.signals, time: l(call.signalled_at, format: "%H:%M"))}
      - if own
        · #{t(".has_call", car: car.call_sign, place: own.place)}
  .sos-actions
    - if call.placed?
      = link_to t(".show_on_map"), root_path(sos: call.id), class: "button button-strip"
    = button_to t(".acknowledge"), call_acknowledgement_path(call), class: "button button-strip"
    - if call.pending?
      = link_to t(".dispatch"), new_call_dispatch_path(call), class: "button button-strip-main",
        data: { turbo_frame: "modal" }
