-#
  DSP-06: one signal — who asks, since when, how well the place is known,
  and the call its car has; then the place on the map, Acknowledge (UPD-13)
  and, until a car is sent, the sending of one (UPD-06).
- car = call.raised_by
- own = car.active_call
%section.sos-strip{ aria: { labelledby: dom_id(call, :strip) }, data: { controller: "waiting", sos_target: "strip" } }
  %span.sos-sign{ aria: { hidden: "true" } } !
  .sos-words
    -# The heading is read out when the strip comes; the minutes, counted on, are not.
    %div
      %h2{ id: dom_id(call, :strip), role: "alert" }
        SOS from #{car.call_sign} · #{l(call.received_at, format: '%H:%M')}
      %span
        ·
        %span{ data: { waiting_target: "minutes", received_at: call.received_at.iso8601 } } #{call.waiting_minutes} min
        ago
    %p
      = call.place_detail
      - if call.signals > 1
        · #{call.signals} signals, the last at #{l(call.signalled_at, format: '%H:%M')}
      - if own
        · #{car.call_sign} has the call at #{own.place}
  .sos-actions
    = link_to "Show on map", root_path(sos: call.id), class: "button button-strip"
    = button_to "Acknowledge", call_acknowledgement_path(call), class: "button button-strip"
    - if call.pending?
      = link_to "Dispatch a car", new_call_dispatch_path(call), class: "button button-strip-main",
        data: { turbo_frame: "modal" }
