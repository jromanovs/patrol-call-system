- content_for(:title, "#{@call.title} — Patrol Call System")
- site = @call.guarded_site
.page-heading
  %h1= @call.title
  - if @call.status.in?(Call::ACTIVE)
    .actions
      = link_to t("common.edit"), edit_call_path(@call), class: "button button-secondary"
  - elsif policy(@call).destroy?
    .actions
      -# BR-23: within the period it is kept for, a call has no Delete.
      - if @call.kept?
        %span.kept-until= t(".kept_until", day: l(@call.kept_until))
      - else
        = button_to t("common.delete"), call_path(@call), method: :delete, class: "button button-secondary",
          form: { data: { turbo_confirm: t(".confirm_delete") } }

- positions = @call.step_positions.where(backup_id: nil).includes(:user).index_by(&:step)
%dl.details
  %div
    %dt= t(".call")
    %dd #{@call.summary}, #{@call.detail}
  - if site
    %div
      %dt= t(".site")
      %dd= link_to site.name, site
  - else
    = render "calls/sos_details", call: @call
  %div
    %dt= t(".priority")
    %dd
      %span{ class: "priority-label priority-#{@call.priority}" }= enum_name(Call, :priority, @call.priority)
  %div
    %dt= t(".status")
    %dd
      %span{ class: "status-label status-#{@call.status.dasherize}" }= enum_name(Call, :status, @call.status)
  %div
    %dt= t(".received")
    %dd= l(@call.received_at)
  - if @call.dispatched_at
    %div
      %dt= t(".dispatched")
      - waited = minutes_between(@call.dispatched_at, @call.received_at)
      %dd= t(".after_receipt", time: l(@call.dispatched_at), count: waited)
  - if @call.accepted_at && @call.dispatched_at
    %div
      %dt= t(".accepted")
      - waited = minutes_between(@call.accepted_at, @call.dispatched_at)
      %dd= t(".after_dispatch", time: l(@call.accepted_at), count: waited)
  - if @call.arrived_at
    %div
      %dt= t(".arrived")
      - waited = minutes_between(@call.arrived_at, @call.dispatched_at)
      %dd= t(".arrived_after", time: l(@call.arrived_at), count: waited, response: decimal(@call.response_minutes))
  = render "calls/step_position", position: positions["arrival"]
  -# 2.10, BR-22: a call its own car has not reached, but a further car has.
  - if @call.arrived_at.nil? && @call.response_minutes
    %div
      %dt= t(".response_time")
      %dd= t(".to_first_car", count: decimal(@call.response_minutes))
  - if @call.closed_at
    %div
      %dt= t(@call.closed? ? ".closed" : ".cancelled")
      - previous = @call.arrived_at || @call.dispatched_at || @call.received_at
      %dd= t(".later", time: l(@call.closed_at), count: minutes_between(@call.closed_at, previous))
  = render "calls/step_position", position: positions["closing"]
  %div
    %dt= t(".total")
    %dd= t(@call.status.in?(Call::ACTIVE) ? ".so_far" : "common.minutes", count: @call.handling_minutes)
  %div
    %dt= t(".car")
    %dd= @call.patrol_car ? link_to(@call.patrol_car.call_sign, @call.patrol_car) : "—"
  %div
    %dt= t(".registered_by")
    -# BR-21: a crew's SOS sent by a phone is registered by nobody.
    %dd= @call.registered_by&.name || t(".traccar_of", car: @call.raised_by.call_sign)
  %div
    %dt= t(".dispatched_by")
    %dd= @call.dispatched_by&.name || "—"
  %div
    %dt= t(".outcome")
    %dd= @call.outcome ? enum_name(Call, :outcome, @call.outcome) : "—"
  %div
    %dt= t(".description")
    %dd.multiline= call_description(@call).presence || "—"
- backups = @call.backups.includes(:patrol_car, :sent_by).order(:sent_at, :id)
= render "calls/backups", call: @call, backups: backups if backups.any?
- photos = @call.photos.includes(:user).order(:id)
= render "calls/photos", call: @call, photos: photos if photos.any?
