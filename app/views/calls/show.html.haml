- content_for(:title, "#{@call.title} — Patrol Call System")
- site = @call.guarded_site
.page-heading
  %h1= @call.title
  - if @call.status.in?(Call::ACTIVE)
    .actions
      = link_to "Edit", edit_call_path(@call), class: "button button-secondary"
  - elsif policy(@call).destroy?
    .actions
      -# BR-23: within the period it is kept for, a call has no Delete.
      - if @call.kept?
        %span.kept-until Kept until #{l(@call.kept_until)}
      - else
        = button_to "Delete", call_path(@call), method: :delete, class: "button button-secondary",
          form: { data: { turbo_confirm: "Delete this call? This cannot be undone." } }

- positions = @call.step_positions.where(backup_id: nil).includes(:user).index_by(&:step)
%dl.details
  %div
    %dt Call
    %dd #{@call.summary}, #{@call.detail}
  - if site
    %div
      %dt Site
      %dd= link_to site.name, site
  - else
    = render "calls/sos_details", call: @call
  %div
    %dt Priority
    %dd
      %span{ class: "priority-label priority-#{@call.priority}" }= @call.priority.humanize
  %div
    %dt Status
    %dd
      %span{ class: "status-label status-#{@call.status.dasherize}" }= @call.status.humanize
  %div
    %dt Received
    %dd= l(@call.received_at)
  - if @call.dispatched_at
    %div
      %dt Dispatched
      %dd #{l(@call.dispatched_at)}, #{minutes_between(@call.dispatched_at, @call.received_at)} min after receipt
  - if @call.accepted_at && @call.dispatched_at
    %div
      %dt Accepted
      %dd #{l(@call.accepted_at)}, #{minutes_between(@call.accepted_at, @call.dispatched_at)} min after dispatch
  - if @call.arrived_at
    %div
      %dt Arrived
      %dd
        #{l(@call.arrived_at)}, #{minutes_between(@call.arrived_at, @call.dispatched_at)} min after dispatch;
        response time #{@call.response_minutes} min
  = render "calls/step_position", position: positions["arrival"]
  -# 2.10, BR-22: a call its own car has not reached, but a further car has.
  - if @call.arrived_at.nil? && @call.response_minutes
    %div
      %dt Response time
      %dd #{@call.response_minutes} min, to the first car that arrived
  - if @call.closed_at
    %div
      %dt= @call.closed? ? "Closed" : "Cancelled"
      - previous = @call.arrived_at || @call.dispatched_at || @call.received_at
      %dd #{l(@call.closed_at)}, #{minutes_between(@call.closed_at, previous)} min later
  = render "calls/step_position", position: positions["closing"]
  %div
    %dt Total
    %dd #{@call.handling_minutes} min#{' so far' if @call.status.in?(Call::ACTIVE)}
  %div
    %dt Car
    %dd= @call.patrol_car ? link_to(@call.patrol_car.call_sign, @call.patrol_car) : "—"
  %div
    %dt Registered by
    -# BR-21: a crew's SOS sent by a phone is registered by nobody.
    %dd= @call.registered_by&.name || "Traccar Client of #{@call.raised_by.call_sign}"
  %div
    %dt Dispatched by
    %dd= @call.dispatched_by&.name || "—"
  %div
    %dt Outcome
    %dd= @call.outcome&.humanize || "—"
  %div
    %dt Description
    %dd.multiline= @call.description.presence || "—"
- backups = @call.backups.includes(:patrol_car, :sent_by).order(:sent_at, :id)
= render "calls/backups", call: @call, backups: backups if backups.any?
- photos = @call.photos.includes(:user).order(:id)
= render "calls/photos", call: @call, photos: photos if photos.any?
