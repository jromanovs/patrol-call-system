- content_for(:title, "#{t('.title')} — Patrol Call System")
.page-heading
  %h1= t(".title")
  .actions
    - if policy(Call).destroy?
      = link_to t(".delete_old"), new_call_cleanup_path, class: "button button-secondary"
    = link_to t(".register"), new_call_path, class: "button"

-# DYN-06: the form stays, only the table and the count below it are reloaded.
= form_with url: calls_path, method: :get, class: "filters",
  data: { turbo_frame: "calls-list", controller: "auto-submit" } do |form|
  = hidden_field_tag :sort, params[:sort]
  = hidden_field_tag :direction, params[:direction]
  = render "filter_fields", form:, filter: @filter

= turbo_frame_tag "calls-list", data: { turbo_action: "advance" } do
  - if @filter.short_text?
    %p.field-error= t("common.too_short")
  - @filter.errors.full_messages.each do |message|
    %p.field-error= message
  .list-summary
    %p.count= t(".count", count: @calls.size)
    - if @filter.active?
      = link_to t("common.clear"), calls_path, class: "clear", data: { turbo_frame: "_top" }
    = link_to t(".statistics"), statistics_path(params.permit(*StatisticsController::FILTERS).to_h.compact_blank),
      class: "statistics-link", data: { turbo_frame: "_top" }
  - if @calls.any?
    %table.data-table{ data: { controller: "waiting" } }
      %thead
        %tr
          %th= sort_link t(".received"), "received_at"
          %th= sort_link t(".priority"), "priority"
          %th= sort_link t(".site"), "site"
          %th= sort_link t(".call"), "type"
          %th= sort_link t(".status"), "status"
          %th= sort_link t(".car"), "car"
          %th= sort_link t(".outcome"), "outcome"
          %th= sort_link t(".time"), "time"
          %th= sort_link t(".response"), "response"
      %tbody
        - @calls.each do |call|
          %tr{ class: ("critical" if call.critical? && call.status.in?(Call::ACTIVE)) }
            %td.numeric{ data: { label: t(".received") } }= l(call.received_at)
            %td{ data: { label: t(".priority") } }
              %span{ class: "priority-label priority-#{call.priority}" }= enum_name(Call, :priority, call.priority)
            %td{ data: { label: t(".site") } }
              = link_to call.place, call_path(call), data: { turbo_frame: "_top" }
            %td{ data: { label: t(".call") } }
              %span.primary= call.summary
              %span.secondary= call.detail
            %td{ data: { label: t(".status") } }
              %span{ class: "status-label status-#{call.status.dasherize}" }= enum_name(Call, :status, call.status)
            %td{ data: { label: t(".car") } }
              = call.patrol_car&.call_sign || "—"
              -# BR-22: the further cars sent, counted.
              - if call.backups.any?
                +#{call.backups.size}
            %td{ data: { label: t(".outcome") } }
              = call.outcome ? enum_name(Call, :outcome, call.outcome) : "—"
            %td.numeric{ data: { label: t(".time") } }
              - if call.status.in?(Call::ACTIVE)
                %span{ data: { waiting_target: "minutes", received_at: call.received_at.iso8601 } }
                  = t("common.minutes", count: call.handling_minutes)
              - else
                = t("common.minutes", count: call.handling_minutes)
            %td.numeric{ data: { label: t(".response") } }
              = call.response_minutes ? t("common.minutes", count: call.response_minutes) : "—"
  - else
    %p= t(".none")
