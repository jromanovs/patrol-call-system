- content_for(:title, "Calls — Patrol Call System")
.page-heading
  %h1 Calls
  = link_to "Register call", new_call_path, class: "button"

-# DYN-06: the form stays, only the table and the count below it are reloaded.
= form_with url: calls_path, method: :get, class: "filters",
  data: { turbo_frame: "calls-list", controller: "auto-submit" } do |form|
  = hidden_field_tag :sort, params[:sort]
  = hidden_field_tag :direction, params[:direction]
  = render "filter_fields", form:, filter: @filter

= turbo_frame_tag "calls-list", data: { turbo_action: "advance" } do
  - if @filter.short_text?
    %p.field-error Enter at least 2 characters
  - @filter.errors.full_messages.each do |message|
    %p.field-error= message
  .list-summary
    %p.count= pluralize(@calls.size, "call")
    - if @filter.active?
      = link_to "Clear", calls_path, class: "clear", data: { turbo_frame: "_top" }
  - if @calls.any?
    %table.data-table{ data: { controller: "waiting" } }
      %thead
        %tr
          %th= sort_link "Received", "received_at"
          %th= sort_link "Priority", "priority"
          %th= sort_link "Site", "site"
          %th= sort_link "Call", "type"
          %th= sort_link "Status", "status"
          %th= sort_link "Car", "car"
          %th= sort_link "Outcome", "outcome"
          %th= sort_link "Time", "time"
          %th= sort_link "Response", "response"
      %tbody
        - @calls.each do |call|
          %tr{ class: ("critical" if call.critical? && call.status.in?(Call::ACTIVE)) }
            %td.numeric{ data: { label: "Received" } }= l(call.received_at)
            %td{ data: { label: "Priority" } }
              %span{ class: "priority-label priority-#{call.priority}" }= call.priority.humanize
            %td{ data: { label: "Site" } }
              = link_to call.guarded_site.name, call_path(call), data: { turbo_frame: "_top" }
            %td{ data: { label: "Call" } }
              %span.primary= call.summary
              %span.secondary= call.detail
            %td{ data: { label: "Status" } }
              %span{ class: "status-label status-#{call.status.dasherize}" }= call.status.humanize
            %td{ data: { label: "Car" } }= call.patrol_car&.call_sign || "—"
            %td{ data: { label: "Outcome" } }= call.outcome&.humanize || "—"
            %td.numeric{ data: { label: "Time" } }
              - if call.status.in?(Call::ACTIVE)
                %span{ data: { waiting_target: "minutes", received_at: call.received_at.iso8601 } }
                  #{call.handling_minutes} min
              - else
                #{call.handling_minutes} min
            %td.numeric{ data: { label: "Response" } }= call.response_minutes ? "#{call.response_minutes} min" : "—"
  - else
    %p No calls match the filter
