%fieldset.type-fields{ hidden: !active, disabled: !active, data: { call_form_target: "client" } }
  %legend.visually-hidden= t("calls.kinds.client")
  .field
    = form.label :caller_name
    %span.hint{ id: form.field_id(:caller_name, :hint) }= t(".caller_name_hint")
    = field_error(call, :caller_name)
    = form.text_field :caller_name, aria: { describedby: field_description(call, :caller_name) }
  .field
    = form.label :caller_phone
    %span.hint{ id: form.field_id(:caller_phone, :hint) }= t(".caller_phone_hint")
    = field_error(call, :caller_phone)
    = form.telephone_field :caller_phone, class: "phone", data: field_check(ClientCall, :caller_phone),
      aria: { describedby: field_description(call, :caller_phone) }
