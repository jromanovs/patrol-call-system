-# DYN-04: one form for both call types; the other type's fields are hidden and disabled, so they are not sent.
- alarm = call.is_a?(AlarmCall)
= form_with model: call, scope: :call, url: call.persisted? ? call_path(call) : calls_path, class: "form",
  data: { controller: "call-form", call_form_priorities_value: AlarmCall::PRIORITIES.to_json } do |form|
  = render "error_summary", form: form, record: call
  .form-card.form
    - unless call.persisted?
      %fieldset.field
        %legend= t(".kind")
        %span.hint#kind-hint= t(".kind_hint")
        .choices
          - call_kinds(CallsController::KINDS.keys).each do |label, value|
            %span.choice
              = form.radio_button :kind, value, checked: (value == "alarm") == alarm,
                aria: { describedby: "kind-hint" }, data: { action: "call-form#toggle" }
              = form.label :kind, label, value: value
      .field
        = form.label :guarded_site_id, t(".site")
        %span.hint{ id: form.field_id(:guarded_site_id, :hint) }= t(".site_hint")
        = field_error(call, :guarded_site_id)
        = form.collection_select :guarded_site_id, sites, :id, :label, { include_blank: t(".choose_site") },
          aria: { describedby: field_description(call, :guarded_site_id) }
      .field
        = form.label :received_at
        %span.hint{ id: form.field_id(:received_at, :hint) }= t(".received_at_hint")
        = field_error(call, :received_at)
        = form.datetime_field :received_at, value: call.received_at&.strftime("%Y-%m-%dT%H:%M"),
          aria: { describedby: field_description(call, :received_at) }
    - if alarm || !call.persisted?
      = render "alarm_fields", form: form, call: call, active: alarm
    - if call.is_a?(ClientCall) || !call.persisted?
      = render "client_fields", form: form, call: call, active: !alarm
    .field
      = form.label :priority
      %span.hint{ id: form.field_id(:priority, :hint) }= t(".priority_hint")
      = field_error(call, :priority)
      = form.select :priority, enum_options(Call, :priority).reverse, { include_blank: t(".default_priority") },
        aria: { describedby: field_description(call, :priority) }, data: { call_form_target: "priority" }
    .field
      = form.label :description do
        = t(".description")
        %span.optional= t("common.optional")
      %span.hint{ id: form.field_id(:description, :hint) }= t(".description_hint")
      = field_error(call, :description)
      = form.text_area :description, rows: 3, aria: { describedby: field_description(call, :description) }
    %div
      = form.submit t(call.persisted? ? ".save" : ".register"), class: "button"
