-# BR-21, DSP-02: who asked for help, where the last signal came from, and who saw it.
%div
  %dt= t(".raised_by")
  %dd= link_to call.raised_by.call_sign, call.raised_by
%div
  %dt= t(".place")
  %dd
    - if call.placed?
      = coordinates(call)
      - if call.accuracy
        · #{t(".accuracy", metres: call.accuracy)}
      - if call.place_time
        · #{t(".last_position", time: call.place_time)}
    - else
      = t(".unknown")
%div
  %dt= t(".signals")
  %dd= t(".signals_last", count: call.signals, time: l(call.signalled_at))
%div
  %dt= t(".acknowledged")
  %dd
    - if call.acknowledged_at
      = t(".acknowledged_by", time: l(call.acknowledged_at), name: call.acknowledged_by.name)
    - else
      —
