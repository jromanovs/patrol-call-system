-# DSP-02, CRW-07: where the crew's phone was at a step, right after the step.
- if position
  %div
    %dt #{position.step.humanize} position
    %dd
      - if position.far?
        %span.arrival{ data: { arrival: "far" } }= step_position_text(position)
      - else
        = step_position_text(position)
