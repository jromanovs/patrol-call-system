-# CALC-02, 2.10: the accepted calls and the average time from sending to acceptance.
%section#acceptance
  %h2= t(".title")
  %table.data-table.compact
    %thead
      %tr
        %th= t(".calls")
        %th.numeric= t(".accepted")
        %th.numeric= t(".average")
    %tbody
      %tr
        %td{ data: { label: t(".calls") } }= t(".all_calls")
        %td.numeric{ data: { label: t(".accepted") } }= statistics.acceptances
        %td.numeric{ data: { label: t(".average") } }= average_minutes(statistics.acceptance)
