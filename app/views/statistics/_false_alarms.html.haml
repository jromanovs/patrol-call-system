-# CALC-03 and CALC-04.
- alarms = statistics.false_alarms
%section#false-alarms
  %h2= t(".title")
  %p.share
    - if alarms.share
      = t(".share", share: decimal(alarms.share), alarms: alarms.count, closed: alarms.closed)
    - else
      = t(".no_closed")
%section#false-alarm-sites
  %h2= t(".sites_title")
  - sites = statistics.false_alarm_sites
  - if sites.any?
    %table.data-table.compact
      %thead
        %tr
          %th= t(".site")
          %th= t(".contract")
          %th.numeric= t(".false_alarms")
      %tbody
        - sites.each do |site, count|
          %tr
            %td{ data: { label: t(".site") } }= link_to site.name, site, data: { turbo_frame: "_top" }
            %td.contract{ data: { label: t(".contract") } }= site.contract_number
            %td.numeric{ data: { label: t(".false_alarms") } }= count
  - else
    %p= t(".none")
