-# CALC-01: the number of calls for each value of one enumeration of a call.
%section{ id: }
  %h2= title
  %table.data-table.compact
    %thead
      %tr
        %th= label
        %th.numeric= t(".calls")
    %tbody
      - counts.each do |value, count|
        %tr
          %td{ data: { label: } }= enum_name(Call, attribute, value)
          %td.numeric{ data: { label: t(".calls") } }= count
    - if total
      %tfoot
        %tr
          %td{ data: { label: } }= t(".total")
          %td.numeric{ data: { label: t(".calls") } }= total
