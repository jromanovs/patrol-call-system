-# CALC-02: arrivals and the average response time, overall and per priority, then per car.
%section#response
  %h2 Response time
  %table.data-table.compact
    %thead
      %tr
        %th Priority
        %th.numeric Arrivals
        %th.numeric Average
    %tbody
      - overall = [ "all calls", statistics.arrivals, statistics.response ]
      - [ overall, *statistics.response_by_priority ].each do |name, count, average|
        %tr
          %td{ data: { label: "Priority" } }= name.humanize
          %td.numeric{ data: { label: "Arrivals" } }= count
          %td.numeric{ data: { label: "Average" } }= average_minutes(average)
%section#response-by-car
  %h2 Response time by car
  %table.data-table.compact
    %thead
      %tr
        %th Car
        %th.numeric Arrivals
        %th.numeric Average
    %tbody
      - statistics.response_by_car.each do |car, count, average|
        %tr
          %td{ data: { label: "Car" } }= link_to car.call_sign, car, data: { turbo_frame: "_top" }
          %td.numeric{ data: { label: "Arrivals" } }= count
          %td.numeric{ data: { label: "Average" } }= average_minutes(average)
