- content_for(:title, "Map — Patrol Call System")
= turbo_refreshes_with method: :morph, scroll: :preserve
.page-heading
  %h1 Map
  - if @map
    %p.map-counts
      #{pluralize(@markers.size, 'site')} under contract · #{@markers.count(&:call)} with an active call

- if @map
  -# DYN-12: a change of any call refreshes the markers on every open map.
  = turbo_stream_from :board
  %ul.map-legend{ aria: { label: "Legend" } }
    - MapsHelper::LEGEND.each do |priority, label|
      %li
        %span.map-marker{ data: { priority: } }= priority.first.upcase unless priority == "none"
        = label
  = render "maps/view", map: @map, markers: @markers, focus: @focus
- else
  %p.flash.flash-notice{ role: "status" }
    Map is being prepared. It is built from the OpenStreetMap data of Latvia and is ready in a few
    minutes; open this page again then.
