-#
  CRW-04, CRW-05, DYN-16: the notices of the car on this phone, signed with the
  server's public key. The script shows the state it finds; a refresh of the
  screen keeps it.
%section.crew-notices#crew-notices{ aria: { label: t(".label") },
  data: { controller: "notices", turbo_permanent: true, notices_key_value: key,
          notices_url_value: push_subscription_path, notices_worker_value: pwa_service_worker_path(format: :js) } }
  %p{ hidden: true, data: { notices_target: "state", state: "on" } }= t(".on")
  %p{ hidden: true, data: { notices_target: "state", state: "off" } }= t(".off")
  %p{ hidden: true, data: { notices_target: "state", state: "blocked" } }= t(".blocked")
  %p{ hidden: true, data: { notices_target: "state", state: "unavailable" } }= t(".unavailable")
  %button.button{ type: "button", hidden: true, data: { notices_target: "on", action: "notices#turnOn" } }
    = t(".turn_on")
  %button.button.button-secondary{ type: "button", hidden: true,
    data: { notices_target: "off", action: "notices#turnOff" } }= t(".turn_off")
