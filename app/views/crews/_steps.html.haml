-#
  CRW-02, CRW-08: the steps of the crew of the call's own car — the route,
  then Accept, Arrived and Close in their turn.
- if call.destination && !call.on_scene?
  = link_to "Route", route_url(call.destination), class: "button button-secondary route", target: "_blank",
    rel: "noopener"
- if call.dispatched?
  -# CRW-02, CRW-06: the crew accepts first; reminders sound until it does.
  = button_to "Accept the call", call_acceptance_path(call), class: "button button-accept",
    form: { data: { turbo_frame: "_top" } }
  - if call.arrival == "unanswered"
    %p.secondary The reminders have stopped; the dispatcher sees the call unanswered.
  - else
    %p.secondary
      While notices are on, a reminder sounds every minute until you accept, up to #{Call::REMINDERS} times.
- elsif call.accepted?
  = form_with url: call_arrival_path(call), data: { turbo_frame: "_top", **crew_position_data } do |form|
    = render "calls/position_fields"
    = form.button "Arrived", class: "button"
- elsif call.on_scene?
  = link_to "Close the call", new_call_closing_path(call), class: "button", data: { turbo_frame: "modal" }
- unless call.dispatched?
  %p.secondary Arrived and Close record where this phone is.
