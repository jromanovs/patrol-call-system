-#
  CRW-02, CRW-08: the steps of the crew of the call's own car — the route,
  then Accept, Arrived and Close in their turn.
- if call.destination && !call.on_scene?
  = link_to t(".route"), route_url(call.destination), class: "button button-secondary route", target: "_blank",
    rel: "noopener"
- if call.dispatched?
  -# CRW-02, CRW-06: the crew accepts first; reminders sound until it does.
  = button_to t(".accept"), call_acceptance_path(call), class: "button button-accept",
    form: { data: { turbo_frame: "_top" } }
  - if call.arrival == "unanswered"
    %p.secondary= t(".reminders_stopped")
  - else
    %p.secondary= t(".reminders", count: Call::REMINDERS)
- elsif call.accepted?
  = form_with url: call_arrival_path(call), data: { turbo_frame: "_top", **crew_position_data } do |form|
    = render "calls/position_fields"
    = form.button t("calls.steps.arrived"), class: "button"
- elsif call.on_scene?
  = link_to t(".close"), new_call_closing_path(call), class: "button", data: { turbo_frame: "modal" }
- unless call.dispatched?
  %p.secondary= t(".position_recorded")
