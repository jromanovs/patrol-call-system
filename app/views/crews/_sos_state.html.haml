-#
  CRW-11: what became of the SOS this car raised — sent, seen by a
  dispatcher, or the cars that are sent (BR-22). It follows the call on the
  open screen without sound: it is no live region, and no notice goes to
  the phones of the crew that asked.
- cars = [ sos.patrol_car, *sos.backups.reject(&:released_at).map(&:patrol_car) ].compact
- seen = sos.acknowledged_at
%section.crew-sos-state{ class: ("coming" if cars.any?) || ("seen" if seen),
  aria: { labelledby: "crew-sos-state-title" } }
  %h2#crew-sos-state-title
    - if cars.any?
      = t(".sent_to_you", cars: cars.map(&:call_sign).to_sentence, count: cars.size)
    - elsif seen
      = t(".seen")
    - else
      = t(".sent", time: l(sos.received_at, format: "%H:%M"))
  - if cars.any?
    - dispatched = t(".dispatched_at", car: sos.patrol_car.call_sign, time: l(sos.dispatched_at, format: "%H:%M"))
    %p= steps_words(dispatched, sos.accepted_at, sos.arrived_at)
    - sos.backups.reject(&:released_at).each do |backup|
      - sent = t(".sent_at", car: backup.patrol_car.call_sign, time: l(backup.sent_at, format: "%H:%M"))
      %p= steps_words(sent, backup.accepted_at, backup.arrived_at)
  - elsif seen
    %p= t(".acknowledged", sent: l(sos.received_at, format: "%H:%M"), seen: l(seen, format: "%H:%M"))
  - else
    %p= t(".not_acknowledged")
