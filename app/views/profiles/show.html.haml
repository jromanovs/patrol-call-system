- content_for(:title, "#{t('.title')} — Patrol Call System")
- user = Current.user
.page-heading
  %h1= t(".title")
%section.setting-card.profile-card{ aria: { label: t(".account") } }
  = avatar(user, aria: { hidden: "true" })
  .profile-who
    %strong.profile-name= user.name
    %span.note #{user.email_address} · #{enum_name(User, :role, user.role)}
    %span.note= t(".changed_by_administrator")
  = link_to t(".change_picture"), edit_profile_picture_path, class: "button button-secondary",
    data: { turbo_frame: "modal" }
%section.profile-rows{ aria: { labelledby: "profile-security-title" } }
  %h2#profile-security-title= t(".security")
  %dl.setting-card
    .row
      %dt= t(".password")
      - if user.crew?
        %dd= t(".password_of_crew")
      - else
        %dd= t(".password_asked")
        %dd= link_to t(".change_password"), edit_password_path, class: "button button-secondary"
    - unless user.crew?
      .row
        %dt= t(".api_key")
        %dd= user.api_key_issued_at ? t(".key_issued", time: l(user.api_key_issued_at)) : t(".no_key")
        %dd
          = link_to api_key_path, class: "button button-secondary" do
            = t(".open_html", page: tag.span(t(".open_page"), class: "visually-hidden"))
