# Secrets for config/deploy.yml. Each value is fetched by a command at deploy
# time; no secret is stored in this file.

# Key of the production credentials (config/credentials/production.yml.enc);
# the key file is never committed.
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# Key with which the server reads the image from the container registry of
# GitHub, from the macOS keychain of the deploying user. It may read
# packages and nothing else.
KAMAL_REGISTRY_PASSWORD=$(security find-generic-password -s patrol-call-system -a KAMAL_REGISTRY_PASSWORD -w)

# Database password from the same keychain.
POSTGRES_PASSWORD=$(security find-generic-password -s patrol-call-system -a POSTGRES_PASSWORD -w)
