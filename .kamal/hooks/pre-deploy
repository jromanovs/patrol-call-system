#!/usr/bin/env ruby

# Stops a deploy to a server whose containers would not see the address of a
# sender that comes over IPv6: with Docker's defaults every such sender shares
# one address of the container network (README, "Server preparation").
require "json"
require "open3"

KAMAL = File.expand_path("../../bin/kamal", __dir__)
READ = [
  "docker network inspect kamal --format 'network={{.EnableIPv6}}'",
  "docker version --format 'engine={{.Server.Version}} experimental={{.Server.Experimental}}'",
  %q(printf 'settings=%s\n' "$(cat /etc/docker/daemon.json 2>/dev/null | tr -d '[:space:]')"),
  "[ ! -e /etc/docker/daemon.json ] || [ -r /etc/docker/daemon.json ] || echo settings=unreadable"
].join("; ")

# From Engine 27 on Docker adds the IPv6 rules that keep the sender's address
# unless its settings switch them off. An older engine adds them only when its
# settings switch them on, and starts with them only in experimental mode. The
# running mode is the one sign of the running engine a deploy user can read:
# it shows settings changed without a restart when the mode was off before.
def rules?(state)
  settings = JSON.parse(state["settings"].to_s.empty? ? "{}" : state["settings"])
  raise JSON::ParserError, "not an object" unless settings.is_a?(Hash)
  return settings.fetch("ip6tables", true) if state["engine"].to_i >= 27

  settings["ip6tables"] == true && state["experimental"] == "true"
end

def fault(host)
  printed, _errors, result = Open3.capture3(KAMAL, "server", "exec", "--raw", "--hosts=#{host}", READ)
  return "it could not be read" unless result.success?

  state = printed.scan(/\b(network|engine|experimental|settings)=(\S*)/).to_h
  if state["engine"].to_s.empty? then "Docker does not answer"
  elsif !state.key?("network") then "there is no network kamal"
  elsif state["network"] != "true" then "the network kamal has no IPv6"
  elsif !rules?(state) then "Docker does not add its IPv6 rules"
  end
rescue JSON::ParserError
  "its Docker settings could not be read"
end

hosts = ENV.fetch("KAMAL_HOSTS", "").split(",")
abort "Deploy stopped: no server is named in KAMAL_HOSTS, so none was checked." if hosts.empty?

faults = hosts.to_h { |host| [ host, fault(host) ] }.compact
exit if faults.empty?

faults.each { |host, reason| warn "#{host} is not prepared for IPv6: #{reason}." }
warn 'Deploy stopped. See README, "Server preparation"; --skip-hooks deploys without this check.'
exit 1
